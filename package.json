{
  "name": "node-postgres",
  "description": "node postgres monorepo",
  "main": "index.js",
  "private": true,
  "repository": "git@github.com:brianc/node-postgres.git",
  "author": "Brian M. Carlson <brian.m.carlson@gmail.com>",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "yarn lerna exec --concurrency 1 yarn test",
    "build": "tsc --build",
    "build:watch": "tsc --build --watch",
    "docs:build": "cd docs && yarn build",
    "docs:start": "cd docs && yarn dev",
    "pretest": "yarn build",
    "prepublish": "yarn build",
    "lint": "eslint --cache 'packages/**/*.{js,ts,tsx}'",
    "bench": "node packages/pg-protocol/bench/run.js",
    "bench:read": "node packages/pg-protocol/bench/run.js read",
    "bench:write": "node packages/pg-protocol/bench/run.js write",
    "bench:gc": "node packages/pg-protocol/bench/run.js gc",
    "bench:loop": "node packages/pg-protocol/bench/run.js loop",
    "bench:pool": "node packages/pg-protocol/bench/run.js pool",
    "bench:pool-micro": "node --expose-gc packages/pg-pool/bench/pool-micro.js",
    "bench:e2e": "node packages/pg-protocol/bench/run.js e2e",
    "bench:big": "node packages/pg-protocol/bench/run.js big",
    "bench:ab": "node packages/pg-protocol/bench/run.js ab",
    "bench:verify": "node packages/pg-protocol/bench/verify.js",
    "bench:guard": "node packages/pg-protocol/bench/run.js guard",
    "bench:all": "node packages/pg-protocol/bench/run.js all"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.1.2",
    "lerna": "^3.19.0",
    "prettier": "3.0.3",
    "typescript": "^6.0.3",
    "@types/node": "^16"
  },
  "prettier": {
    "semi": false,
    "printWidth": 120,
    "arrowParens": "always",
    "trailingComma": "es5",
    "singleQuote": true
  }
}
